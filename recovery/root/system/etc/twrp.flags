#
# TWRP/OrangeFox flags for Motorola Edge 70 Fusion (marvel / XT2605)

# --- Logical (dynamic) partitions -------------------------------------------
/system_image      emmc   /dev/block/mapper/system        flags=display="System Image";backup=1;flashimg=1;slotselect;logical
/system            erofs  /dev/block/mapper/system        flags=display="System";slotselect;logical
/system            ext4   /dev/block/mapper/system        flags=display="System";slotselect;logical
/system_ext_image  emmc   /dev/block/mapper/system_ext    flags=display="System EXT Image";backup=1;flashimg=1;slotselect;logical
/system_ext        erofs  /dev/block/mapper/system_ext    flags=display="System EXT";slotselect;logical
/system_ext        ext4   /dev/block/mapper/system_ext    flags=display="System EXT";slotselect;logical
/product_image     emmc   /dev/block/mapper/product       flags=display="Product Image";backup=1;flashimg=1;slotselect;logical
/product           erofs  /dev/block/mapper/product       flags=display="Product";slotselect;logical
/product           ext4   /dev/block/mapper/product       flags=display="Product";slotselect;logical
/vendor_image      emmc   /dev/block/mapper/vendor        flags=display="Vendor Image";backup=1;flashimg=1;slotselect;logical
/vendor            erofs  /dev/block/mapper/vendor        flags=display="Vendor";slotselect;logical
/vendor            ext4   /dev/block/mapper/vendor        flags=display="Vendor";slotselect;logical
/vendor_dlkm_image emmc   /dev/block/mapper/vendor_dlkm   flags=display="Vendor DLKM Image";backup=1;flashimg=1;slotselect;logical
/vendor_dlkm       erofs  /dev/block/mapper/vendor_dlkm   flags=display="Vendor DLKM";slotselect;logical
/vendor_dlkm       ext4   /dev/block/mapper/vendor_dlkm   flags=display="Vendor DLKM";slotselect;logical
/system_dlkm_image emmc   /dev/block/mapper/system_dlkm   flags=display="System DLKM Image";backup=1;flashimg=1;slotselect;logical
/system_dlkm       erofs  /dev/block/mapper/system_dlkm   flags=display="System DLKM";slotselect;logical
/system_dlkm       ext4   /dev/block/mapper/system_dlkm   flags=display="System DLKM";slotselect;logical

# --- Boot / verified boot ---------------------------------------------------
/boot           emmc  /dev/block/bootdevice/by-name/boot           flags=display="Boot";backup=1;flashimg=1;slotselect
/init_boot      emmc  /dev/block/bootdevice/by-name/init_boot      flags=display="Init-Boot";backup=1;flashimg=1;slotselect
/vendor_boot    emmc  /dev/block/bootdevice/by-name/vendor_boot    flags=display="Vendor-Boot";backup=1;flashimg=1;slotselect
/recovery       emmc  /dev/block/bootdevice/by-name/recovery       flags=display="Recovery";backup=1;flashimg=1;slotselect
/dtbo           emmc  /dev/block/bootdevice/by-name/dtbo           flags=display="DTBO";backup=1;flashimg=1;slotselect
/vbmeta         emmc  /dev/block/bootdevice/by-name/vbmeta         flags=display="VBMeta";backup=1;flashimg=1;slotselect
/vbmeta_system  emmc  /dev/block/bootdevice/by-name/vbmeta_system  flags=display="VBMeta System";backup=1;flashimg=1;slotselect

# --- Data / metadata --------------------------------------------------------
/data       f2fs  /dev/block/bootdevice/by-name/userdata  flags=display="Data";backup=1;wipeingui=1;encryptable=userdata
/metadata   f2fs  /dev/block/bootdevice/by-name/metadata  flags=display="Metadata";backup=1;wipeingui=1;fsflags="noatime,nosuid,nodev,discard,data_flush wait";wrappedkey

# --- Motorola calibration / firmware ---------------------------------------
/persist        ext4  /dev/block/bootdevice/by-name/persist        flags=display="Persist";backup=1;wipeingui=0;flashimg=0
/persist_image  emmc  /dev/block/bootdevice/by-name/persist        flags=display="Persist";flashimg=1;backup=1
/mnt/product/persist   ext4  /dev/block/bootdevice/by-name/prodpersist flags=display="Product Persist";backup=1;wipeingui=0;flashimg=0
/mnt/product/logks     ext4  /dev/block/bootdevice/by-name/logks       flags=display="LOGKS";backup=1
/modem          vfat  /dev/block/bootdevice/by-name/modem          flags=display="Modem/Firmware";backup=1;slotselect
/dsp            ext4  /dev/block/bootdevice/by-name/dsp            flags=display="DSP";backup=1;slotselect
/bluetooth      ext4  /dev/block/bootdevice/by-name/bluetooth      flags=display="Bluetooth";backup=1;slotselect
/fsg            ext4  /dev/block/bootdevice/by-name/fsg            flags=display="FSG";backup=1
/spunvm         vfat  /dev/block/bootdevice/by-name/spunvm         flags=display="SPUNVM";backup=1

# --- Misc -------------------------------------------------------------------
/misc   emmc  /dev/block/bootdevice/by-name/misc  flags=display="Misc"
/frp    emmc  /dev/block/bootdevice/by-name/frp   flags=display="FRP";backup=1;wipeingui=0;flashimg=0

# --- Removable --------------------------------------------------------------
/usb_otg  vfat  /dev/block/sdg1  /dev/block/sdg  flags=display="USB-OTG";storage;wipeingui;removable;fsync=posix
