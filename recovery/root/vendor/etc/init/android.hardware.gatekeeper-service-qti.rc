# Source: /vendor/etc/init/android.hardware.gatekeeper-service-qti.rc
# (copy the stock file over this one when extracting the dump)

service vendor.gatekeeper-qti /vendor/bin/hw/android.hardware.gatekeeper-service-qti
    interface aidl android.hardware.gatekeeper.IGatekeeper/default
    user root
    group root system
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64:/bin
    seclabel u:r:recovery:s0
    task_profiles CPUSET_SP_FOREGROUND
    disabled
