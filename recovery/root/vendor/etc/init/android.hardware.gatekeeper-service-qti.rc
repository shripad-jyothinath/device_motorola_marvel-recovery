#
# Derived from the stock /vendor/etc/init/android.hardware.gatekeeper-service-qti.rc
#
# IMPORTANT: the stock unit is disabled and is only enabled when
#   vendor.gatekeeper.is_security_level_spu=0
# is set:
#
#   on property:vendor.gatekeeper.is_security_level_spu=0
#       enable vendor.gatekeeper_default
#
# That prop is part of the stock vendor build.prop and is REQUIRED for
# decryption. It must be present in system.prop/vendor.prop.
# (`disabled` removed here because init.recovery.encryption.rc starts it
#  explicitly after qseecomd is up.)

service vendor.gatekeeper_default /vendor/bin/hw/android.hardware.gatekeeper-service-qti
    class early_hal
    user root
    group root system
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64:/bin
    seclabel u:r:recovery:s0
