#
# Derived from the stock /vendor/etc/init/android.hardware.weaver-service.nxp.rc
#
# NOTE the stock service name is `vendor.weaver_nxp` (not `vendor.weaver`) and
# the binary is `android.hardware.weaver-service.nxp-qti`.
#
# Stock gating (reproduced in init.recovery.encryption.rc):
#   on boot && property:ro.boot.strongbox_support=true
#       start vendor.weaver_nxp

service vendor.weaver_nxp /vendor/bin/hw/android.hardware.weaver-service.nxp-qti
    class hal
    user root
    group root drmrpc
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64:/bin
    seclabel u:r:recovery:s0
