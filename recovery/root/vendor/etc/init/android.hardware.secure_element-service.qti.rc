#
# Source: /vendor/etc/init/android.hardware.secure_element-service.qti.rc
# (copy the stock file over this one when extracting the dump)
#
# The dnes SKU declares ISecureElement/SIM1, /SIM2 and /eSE1
# (see odm/etc/vintf/manifest_dnes.xml).

service vendor.secure_element /vendor/bin/hw/android.hardware.secure_element-service.qti
    interface aidl android.hardware.secure_element.ISecureElement/eSE1
    user root
    group root system
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64:/bin
    seclabel u:r:recovery:s0
    task_profiles CPUSET_SP_FOREGROUND
    disabled
