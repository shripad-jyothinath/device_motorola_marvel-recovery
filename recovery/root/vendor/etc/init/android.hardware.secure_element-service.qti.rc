#
# Derived from the stock
# /vendor/etc/init/android.hardware.secure_element-service.qti.rc
#
# Stock gating: started on boot when ro.vendor.hw.nfc is ese_st or ese_nq.
# In recovery we start it directly (see init.recovery.encryption.rc).

service vendor.secure_element /vendor/bin/hw/android.hardware.secure_element-service.qti
    class hal
    user root
    group root system nfc
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64:/bin
    seclabel u:r:recovery:s0
