#
# Derived from the stock /vendor/etc/init/qseecomd.rc, adapted for recovery
# (recovery seclabel, no auto-start - init.recovery.encryption.rc drives it).

service vendor.qseecomd /vendor/bin/qseecomd
    socket notify-topology stream 660 system drmrpc
    class core
    user root
    group root drmrpc
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64:/bin
    seclabel u:r:recovery:s0
