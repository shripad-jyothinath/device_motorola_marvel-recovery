# Derived from the stock /vendor/etc/init/ssgtzd.rc, adapted for recovery.

service vendor.ssgtzd /vendor/bin/ssgtzd
    class late_start
    user root
    group root system wakelock
    capabilities WAKE_ALARM BLOCK_SUSPEND
    socket ssgtzd stream 0660 system system
    socket ssgtzd_opener stream 0660 system system
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64:/bin
    seclabel u:r:recovery:s0
