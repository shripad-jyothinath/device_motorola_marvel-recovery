#
# Derived from the stock /vendor/etc/init/android.hardware.security.keymint-service-qti.rc
# (the always-present TZ-backed KeyMint path), adapted for recovery.

service vendor.keymint-qti /vendor/bin/hw/android.hardware.security.keymint-service-qti
    class early_hal
    user root
    group root system drmrpc
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64:/bin
    seclabel u:r:recovery:s0
