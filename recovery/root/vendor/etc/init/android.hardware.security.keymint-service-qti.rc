#
# The default (TZ-backed) KeyMint path, always present.
# Source: /vendor/etc/init/android.hardware.security.keymint-service-qti.rc
# (copy the stock file over this one when extracting the dump)

service vendor.keymint-qti /vendor/bin/hw/android.hardware.security.keymint-service-qti
    interface aidl android.hardware.security.keymint.IKeyMintDevice/default
    interface aidl android.hardware.security.secureclock.ISecureClock/default
    interface aidl android.hardware.security.sharedsecret.ISharedSecret/default
    user root
    group root system wakelock
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64:/bin
    seclabel u:r:recovery:s0
    task_profiles CPUSET_SP_FOREGROUND
    disabled
