<!--
    Stock marvel declares the QTI gatekeeper in vendor/etc/vintf/manifest_volcano.xml,
    which recovery does not ship. Without this fragment servicemanager refuses the
    IGatekeeper/default registration and decryption cannot verify the lockscreen.
-->
<manifest version="1.0" type="device">
    <hal format="aidl">
        <name>android.hardware.gatekeeper</name>
        <fqname>IGatekeeper/default</fqname>
    </hal>
</manifest>
