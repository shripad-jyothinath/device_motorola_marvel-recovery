# Platform-common vendor properties for SM7635 (volcano)

# Audio
ro.vendor.audio_sdk.sku=volcano
ro.vendor.audio_hal.sku=volcano

# Bluetooth
persist.vendor.btstack.enable.splita2dp=true
persist.vendor.btstack.a2dp_offload_cap=sbc-aptx-aptxtws-aptxhd-aac-ldac-aptxadaptive-aptx.tws
ro.vendor.bluetooth.library_name=libbluetooth_qti.so

# Camera
ro.vendor.camera.cf.flashlight=1

# Chipset
ro.vendor.qti.ambs.register.audio_listener=true

# CRIU
ro.vendor.esi.mode=7

# Display
ro.vendor.display.hbm_backlight_scale=200
ro.vendor.display.sensortype=2
ro.vendor.display.paneltype=2
ro.vendor.display.foss=1
ro.surface_flinger.has_wide_color_display=true
ro.surface_flinger.has_HDR_display=true
ro.surface_flinger.use_color_management=true
ro.surface_flinger.wcg_composition_dataspace=143261696
ro.surface_flinger.protected_contents=true
ro.surface_flinger.use_content_detection_for_refresh_rate=true
ro.surface_flinger.set_touch_timer_ms=1000
ro.surface_flinger.force_hwc_copy_for_virtual_displays=true
ro.surface_flinger.max_frame_buffer_acquired_buffers=3
ro.surface_flinger.max_virtual_display_dimension=4096
ro.surface_flinger.clear_slots_with_set_layer_buffer=false
ro.surface_flinger.supports_background_blur=0
ro.surface_flinger.game_default_frame_rate_override=60
ro.surface_flinger.enable_frame_rate_override=true
ro.surface_flinger.set_display_power_timer_ms=1000
ro.surface_flinger.primary_frame_stride=1440
ro.surface_flinger.primary_display_orientation_mode=0
debug.sf.hw=0
debug.egl.hw=0
debug.sf.enable_gl_backpressure=1
debug.sf.disable_backpressure=0
debug.sf.force_set_doze_before_suspend=1
debug.sf.enable_hwc_vds=0
debug.sf.enable_advanced_sf_phase_offset=0
debug.sf.use_phase_offsets_as_durations=0
debug.sf.high_fps_late_sf_phase_offset_ns=-4000000
debug.sf.high_fps_late_app_phase_offset_ns=1000000
debug.sf.high_fps_early_phase_offset_ns=-4000000
debug.sf.high_fps_early_gl_phase_offset_ns=-4000000
debug.sf.latch_unsignaled=0
debug.sf.auto_latch_unsignaled=1
debug.sf.disable_client_composition_cache=1
debug.sf.predict_hwc_composition_strategy=0
vendor.gralloc.enable_snapalloc=1
vendor.display.foss.config=1
vendor.display.foss.config_path=/vendor/etc/display/FOSSConfig.xml
# Keep HDR layers in the GPU target. Full-screen device composition does not
# apply the panel's HDR brightness path correctly on Motorola's display stack.
vendor.display.enable_hdr10_gpu_target=1
vendor.display.only_report_first_mode=1
vendor.display.disable_scaler=0
vendor.display.disable_excl_rect=0
vendor.display.disable_excl_rect_partial_fb=1
vendor.display.comp_mask=0
vendor.display.disable_idle_fps_switch=1
vendor.display.force_lm_to_fb_config=1
vendor.display.disable_cwb_idle_fallback=1

# DRM
drm.service.enabled=true

# FRP
ro.frp.pst=/dev/block/bootdevice/by-name/frp

# Gatekeeper
ro.vendor.gatekeeper.algorithm=gatekeeper

# Graphics
ro.hardware.egl=adreno
ro.hardware.vulkan=adreno
ro.opengles.version=196610

# Keymaster
ro.vendor.keymaster.nonsecure_algorithm=gatekeeper
vendor.keymint.retry_timer=5
ro.hardware.keystore_desede=true

# Media
ro.media.xmlvariant.codecs=volcano

# NFC
ro.vendor.nfc.fwdump.dmgz=0

# Radio
ro.vendor.radio.5g=1
ro.vendor.radio.apm.sim.not.persist=1
ro.vendor.radio.enableadvancedpowersaving=1
ro.vendor.use_data_netmgr_manager=true
persist.vendor.data.mode=concurrent
persist.radio.multisim.config=dsds
persist.vendor.radio.aosp_usr_pref_sel=true
persist.vendor.radio.apm_sim_not_pwdn=1
persist.vendor.radio.custom_ecc=1
persist.vendor.radio.enable_temp_dds=true
persist.vendor.radio.flexmap_type=none
persist.vendor.radio.sib16_support=1
persist.vendor.radio.report_codec=1

# RIL
persist.vendor.radio.add_power_save=1
persist.vendor.radio.data_ltd_sys_ind=1

# Sensors
ro.vendor.sensors.glapproach=false
ro.vendor.sensors.mot_lgy=true
ro.vendor.sensors.pedometer=false
ro.vendor.sensors.ring_picker=false

# Sockets
ro.vendor.extension_library=libqti-perfd-client.so

# Storage
ro.vendor.crypto.fde_algorithm=otfe
ro.vendor.crypto.fde_scrypt_params=12:3:1:1
ro.crypto.metadata_init_delete_all_keys.enabled=true
ro.sys.fw.bgapp_limit=24

# USB
ro.vendor.usb.controller=a600000.dwc3
ro.vendor.usb.productfs_config=1
sys.usb.mtp.batchcancel=1
vendor.usb.use_ffs_mtp=1
vendor.usb.use_gadget_hal=0

# Virtual A/B
ro.virtual_ab.enabled=true
ro.virtual_ab.compression.enabled=true
ro.virtual_ab.userspace.snapshots.enabled=true

# WiFi
ro.vendor.wifi.vht__su_beamformer=1
ro.vendor.wifi.vht_beamformer=1
ro.vendor.wifi.sap_congestion_scan=1
ro.vendor.wifi.sap_dfs_as_sta=true
ro.vendor.wifi.activity_timeout=100

# Zygote
ro.vendor.zygote=zygote64
