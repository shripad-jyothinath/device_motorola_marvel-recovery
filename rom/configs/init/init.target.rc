import /vendor/etc/init/hw/init.qti.kernel.rc
import /vendor/etc/init/hw/init.mmi.rc

on early-init
    write /proc/sys/kernel/printk_devkmsg ratelimited
    export MEMTAG_OPTIONS off
    write /metadata/stage_early_init 1
    mkdir /dev/boringssl 0777 root root
    mkdir /dev/boringssl/selftest 0777 root root
    chmod 0777 /dev/boringssl
    chmod 0777 /dev/boringssl/selftest
    # Force configfs mode and controller identifiers
    setprop sys.usb.configfs 1
    setprop sys.usb.controller a600000.dwc3
    setprop vendor.usb.controller a600000.dwc3
    # Satisfy early HAL and system property blockers
    setprop hwservicemanager.ready true
    setprop bpf.progs_loaded 1
    setprop keystore.module_hash.sent true
    setprop persist.sys.usb.config adb
    setprop sys.usb.config adb

on init
    write /metadata/stage_init 1
    mkdir /dev/boringssl 0777 root root
    mkdir /dev/boringssl/selftest 0777 root root
    chmod 0777 /dev/boringssl
    chmod 0777 /dev/boringssl/selftest
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    chown system system /sys/devices/platform/soc/1d84000.ufshc/auto_hibern8
    chmod 0660 /sys/devices/platform/soc/1d84000.ufshc/auto_hibern8
    start logd

    # Staging authorized host keys in rootfs fallback
    copy /metadata/overlay/hw/adb_keys /adb_keys
    chmod 0644 /adb_keys
    chown root root /adb_keys
    restorecon /adb_keys

    # Inject dynamic linker config to bridge APEX i18n & isolated namespaces
    copy /metadata/overlay/ld.config.txt /linkerconfig/ld.config.txt
    copy /metadata/overlay/ld.config.txt /linkerconfig/bootstrap/ld.config.txt
    chmod 0644 /linkerconfig/ld.config.txt
    chmod 0644 /linkerconfig/bootstrap/ld.config.txt

    # Configure USB gadget identity directly
    setprop sys.usb.configfs 1
    setprop sys.usb.controller a600000.dwc3
    setprop vendor.usb.controller a600000.dwc3
    write /config/usb_gadget/g1/idVendor 0x22b8
    write /config/usb_gadget/g1/idProduct 0x2e81
    write /config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno}
    write /config/usb_gadget/g1/strings/0x409/manufacturer "Motorola"
    write /config/usb_gadget/g1/strings/0x409/product "Motorola Edge 70 Fusion"

    # Ensure USB SS controller is in peripheral mode
    wait /sys/bus/platform/devices/a600000.ssusb/mode
    write /sys/bus/platform/devices/a600000.ssusb/mode peripheral

on early-fs
    write /metadata/stage_early_fs 1
    start vold

on fs
    write /metadata/stage_fs 1
    mount_all --early
    chown root system /mnt/vendor/persist
    chmod 0771 /mnt/vendor/persist
    restorecon_recursive /mnt/vendor/persist
    mkdir /mnt/vendor/persist/secnvm 0770 system system
    mkdir /mnt/vendor/persist/data 0700 system system

on post-fs
    write /metadata/stage_post_fs 1
    # Start persistent diagnostic loggers to metadata disk
    start boot_dmesg
    start boot_logcat
    # Execute virtualization manager
    enable vendor.qvirtservice_rs
    start  vendor.qvirtservice_rs

on late-fs
    write /metadata/stage_late_fs 1
    # Re-assert dynamic linker config before early_hal starts keystore2
    copy /metadata/overlay/ld.config.txt /linkerconfig/ld.config.txt
    copy /metadata/overlay/ld.config.txt /linkerconfig/bootstrap/ld.config.txt
    chmod 0644 /linkerconfig/ld.config.txt
    chmod 0644 /linkerconfig/bootstrap/ld.config.txt
    setprop hwservicemanager.ready true
    mount_all --late

on post-fs-data
    write /metadata/stage_post_fs_data 1
    # Re-assert ADB config against Motorola load-bpf-programs wiping
    setprop persist.sys.usb.config adb
    setprop sys.usb.config adb
    setprop sys.usb.configfs 1
    setprop bpf.progs_loaded 1
    setprop keystore.module_hash.sent true

    mkdir /vendor/data/tombstones 0771 system system
    # Enable WLAN cold boot calibration
    write /sys/kernel/cnss/fs_ready 1

on property:apexd.status=activated
    # Re-apply comprehensive dynamic linker bridge over linkerconfig output
    copy /metadata/overlay/ld.config.txt /linkerconfig/ld.config.txt
    copy /metadata/overlay/ld.config.txt /linkerconfig/default/ld.config.txt
    chmod 0644 /linkerconfig/ld.config.txt
    chmod 0644 /linkerconfig/default/ld.config.txt

on early-boot
    write /metadata/stage_early_boot 1
    verity_update_state

on boot
    write /metadata/stage_boot 1
    # Stage authorized host keys into data after encryption policy is established
    mkdir /data/misc/adb 02750 system shell
    copy /metadata/overlay/hw/adb_keys /data/misc/adb/adb_keys
    chown system shell /data/misc/adb/adb_keys
    chmod 0640 /data/misc/adb/adb_keys
    restorecon -R /data/misc/adb
    start adbd
    write /dev/cpuset/audio-app/cpus 0-1
    # Add a cpuset for the camera daemon
    mkdir /dev/cpuset/camera-daemon
    write /dev/cpuset/camera-daemon/cpus 0-7
    write /dev/cpuset/camera-daemon/mems 0
    chown cameraserver cameraserver /dev/cpuset/camera-daemon
    chown cameraserver cameraserver /dev/cpuset/camera-daemon/tasks
    chmod 0660 /dev/cpuset/camera-daemon/tasks
    chown system /sys/devices/platform/soc/990000.i2c/i2c-0/0-0038/trusted_touch_enable
    chmod 0660 /sys/devices/platform/soc/990000.i2c/i2c-0/0-0038/trusted_touch_enable
    chown system /sys/devices/platform/soc/990000.spi/spi_master/spi0/spi0.0/trusted_touch_enable
    chmod 0660 /sys/devices/platform/soc/990000.spi/spi_master/spi0/spi0.0/trusted_touch_enable
    chown system /sys/devices/system/cpu/hyp_core_ctl/enable
    chown system /sys/devices/system/cpu/hyp_core_ctl/hcc_min_freq

on property:vendor.display.lcd_density=560
   setprop dalvik.vm.heapgrowthlimit 256m

on property:vendor.display.lcd_density=640
   setprop dalvik.vm.heapgrowthlimit 512m

on init && property:ro.boot.mode=charger
    setprop vendor.all.modules.ready 1
    mount_all /vendor/etc/charger_fw_fstab.qti --early
    start vendor.pd_mapper
    wait /sys/kernel/boot_adsp/boot
    write /sys/kernel/boot_adsp/boot 1

on charger
    start vendor.power_off_alarm
    write /sys/kernel/cnss/charger_mode 1

# adbd is started cleanly in on boot after encryption policy and host keys are staged

# Unconditional hardware UDC binding trigger:
# As soon as adbd initializes /dev/usb-ffs/adb/ep0, bind directly to hardware!
on property:sys.usb.ffs.ready=1
    write /config/usb_gadget/g1/UDC "none"
    write /config/usb_gadget/g1/idVendor 0x22b8
    write /config/usb_gadget/g1/idProduct 0x2e81
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "adb"
    rm /config/usb_gadget/g1/configs/b.1/f1
    rm /config/usb_gadget/g1/configs/b.1/f2
    rm /config/usb_gadget/g1/configs/b.1/f3
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f1
    write /config/usb_gadget/g1/UDC a600000.dwc3
    setprop sys.usb.state adb

# Logging services
service boot_dmesg /metadata/overlay/hw/logger.sh
    class core
    user root
    group root
    seclabel u:r:su:s0
    oneshot

service boot_logcat /metadata/overlay/hw/logcat.sh
    class core
    user root
    group root
    seclabel u:r:su:s0
    oneshot

# pd-mapper
service vendor.pd_mapper /vendor/bin/pd-mapper
    class core
    user system
    group system

# Peripheral manager
service vendor.per_mgr /vendor/bin/pm-service
    class core
    user system
    group system
    ioprio rt 4

service vendor.per_proxy /vendor/bin/pm-proxy
    class core
    user system
    group system
    disabled

service vendor.mdm_launcher /vendor/bin/sh /vendor/bin/init.mdm.sh
    class core
    oneshot

on property:init.svc.vendor.per_mgr=running
    start vendor.per_proxy

on property:sys.shutdown.requested=*
    write /sys/kernel/qcom_rproc/shutdown_in_progress 1
    stop vendor.per_proxy

on property:vold.decrypt=trigger_restart_framework
   start vendor.cnss_diag

service vendor.cnss_diag /system/vendor/bin/cnss_diag -q -f -t HELIUM
   class main
   user system
   group system wifi inet sdcard_rw media_rw diag
   oneshot

on early-boot && property:persist.vendor.pcie.boot_option=*
    write /sys/bus/platform/devices/1c00000.qcom,pcie/debug/boot_option ${persist.vendor.pcie.boot_option}
    write /sys/bus/platform/devices/1c08000.qcom,pcie/debug/boot_option ${persist.vendor.pcie.boot_option}

service fan_control_turn_on /vendor/bin/fan_service 1
    class late_start
    user root
    disabled
    oneshot

service fan_control_turn_off /vendor/bin/fan_service 0
    class late_start
    user root
    disabled
    oneshot


# Override BoringSSL self tests to eliminate reboot_on_failure and use 0-dep static binary
service boringssl_self_test_apex64 /vendor/bin/boringssl_self_test64
    override
    user root

service boringssl_self_test_apex32 /vendor/bin/boringssl_self_test64
    override
    user root

service boringssl_self_test64 /vendor/bin/boringssl_self_test64
    override
    user root

service boringssl_self_test32 /vendor/bin/boringssl_self_test64
    override
    user root

service netd1shot /vendor/bin/boringssl_self_test64
    override
    user root

service bpfloader /vendor/bin/boringssl_self_test64
    override
    user root

# Mitigate sscrpcd logcat spam during early bringup
service vendor.sensors /vendor/bin/sscrpcd sensorspd
    override
    disabled

# Mitigate adsprpcd, cdsprpcd, audioadsprpcd fastrpc crash loop and logcat flood
service vendor.adsprpcd /vendor/bin/adsprpcd
    override
    disabled

service vendor.cdsprpcd /vendor/bin/cdsprpcd
    override
    disabled

service vendor.audioadsprpcd_audiopd /vendor/bin/audioadsprpcd audiopd
    override
    disabled